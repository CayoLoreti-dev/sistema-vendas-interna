generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  VENDEDOR
  FUNCIONARIO
}

enum StatusPedido {
  FIADO
  PAGO
}

enum MetodoPagamento {
  FIADO
  PIX
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  COLOCOU_PRA_VENDA
}

model Usuario {
  id                   String                @id @default(uuid())
  nome                 String
  telefone             String                @unique
  senha                String // hash do PIN
  papel                Papel                 @default(FUNCIONARIO)
  criadoEm             DateTime              @default(now())
  pedidos              Pedido[]
  pushSubscriptions    PushSubscription[]
  estoquesInternos     EstoqueInterno[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@map("usuarios")
}

model Produto {
  id                   String                @id @default(uuid())
  nome                 String
  categoria            String?
  preco                Decimal               @db.Decimal(10, 2)
  precoPromocional     Decimal?              @db.Decimal(10, 2)
  promocaoAtiva        Boolean               @default(false)
  estoqueAtual         Int                   @default(0)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  itensPedido          ItemPedido[]
  estoquesInternos     EstoqueInterno[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@map("produtos")
}

model Pedido {
  id              String          @id @default(uuid())
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  usuarioId       String
  status          StatusPedido    @default(FIADO)
  metodoPagamento MetodoPagamento
  valorTotal      Decimal         @db.Decimal(10, 2)
  criadoEm        DateTime        @default(now())
  pagoEm          DateTime?
  itens           ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  pedidoId      String
  produto       Produto @relation(fields: [produtoId], references: [id])
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) // snapshot do preco no momento da compra

  @@map("itens_pedido")
}

model PushSubscription {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@map("push_subscriptions")
}

model Configuracao {
  id           String   @id @default(uuid())
  chave        String   @unique
  valor        String
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}

model EstoqueInterno {
  id            String                @id @default(uuid())
  vendedor      Usuario               @relation(fields: [vendedorId], references: [id])
  vendedorId    String
  produto       Produto               @relation(fields: [produtoId], references: [id])
  produtoId     String
  quantidade    Int                   @default(0)
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]

  @@unique([vendedorId, produtoId])
  @@map("estoques_internos")
}

model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  estoque    EstoqueInterno          @relation(fields: [estoqueId], references: [id])
  estoqueId  String
  vendedor   Usuario                 @relation(fields: [vendedorId], references: [id])
  vendedorId String
  produto    Produto                 @relation(fields: [produtoId], references: [id])
  produtoId  String
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  criadoEm   DateTime                @default(now())

  @@map("movimentacoes_estoque")
}
