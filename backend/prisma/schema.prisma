generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  VENDEDOR
  FUNCIONARIO
}

enum StatusPedido {
  FIADO
  PAGO
}

enum MetodoPagamento {
  FIADO
  PIX
}

model Usuario {
  id                String             @id @default(uuid())
  nome              String
  telefone          String             @unique
  senha             String             // hash do PIN
  papel             Papel              @default(FUNCIONARIO)
  criadoEm          DateTime           @default(now())
  pedidos           Pedido[]
  pushSubscriptions PushSubscription[]

  @@map("usuarios")
}

model Produto {
  id           String   @id @default(uuid())
  nome         String
  categoria    String?
  preco        Decimal  @db.Decimal(10, 2)
  estoqueAtual Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  itensPedido  ItemPedido[]

  @@map("produtos")
}

model Pedido {
  id              String          @id @default(uuid())
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  usuarioId       String
  status          StatusPedido    @default(FIADO)
  metodoPagamento MetodoPagamento
  valorTotal      Decimal         @db.Decimal(10, 2)
  criadoEm        DateTime        @default(now())
  pagoEm          DateTime?
  itens           ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedido        Pedido  @relation(fields: [pedidoId], references: [id])
  pedidoId      String
  produto       Produto @relation(fields: [produtoId], references: [id])
  produtoId     String
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) // snapshot do preco no momento da compra

  @@map("itens_pedido")
}

model PushSubscription {
  id        String   @id @default(uuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@map("push_subscriptions")
}

model Configuracao {
  id           String   @id @default(uuid())
  chave        String   @unique
  valor        String
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}
